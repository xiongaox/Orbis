<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="八字排盘 - 专业的命理分析工具">
    <title>随心所欲 - 八字排盘系统</title>
    <link rel="stylesheet" href="styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;600;700&family=Noto+Serif+SC:wght@400;500;600;700&display=swap"
        rel="stylesheet">
</head>

<body>
    <!-- 顶部导航栏 -->
    <header class="navbar">
        <div class="navbar-brand">
            <div class="logo">
                <span class="logo-icon">☯</span>
                <span class="logo-text">随心所欲</span>
            </div>
        </div>
        <nav class="navbar-nav">
            <a href="#" class="nav-link active">排盘</a>
            <a href="#" class="nav-link">大运</a>
            <a href="#" class="nav-link">流年</a>
            <a href="#" class="nav-link">合婚</a>
            <a href="#" class="nav-link">择日</a>
        </nav>
        <div class="navbar-actions">
            <button class="btn btn-ghost">
                <span class="icon">🌙</span>
            </button>
            <button class="btn btn-primary">登录</button>
        </div>
    </header>

    <!-- 主体内容区 -->
    <main class="main-container figma-main">
        <!-- 左侧栏 - 案例列表 -->
        <aside class="sidebar sidebar-left">
            <!-- 搜索框 -->
            <div class="search-box">
                <input type="text" class="search-input" placeholder="搜索案例...">
                <span class="search-icon">🔍</span>
            </div>

            <!-- 案例列表 -->
            <div class="case-list">
                <div class="case-item active">
                    <div class="case-info">
                        <div class="case-header">
                            <span class="case-name">案例6</span>
                            <span class="case-gender female">女</span>
                        </div>
                        <div class="case-date">阳历：1998年10月16日</div>
                    </div>
                    <div class="case-pillars">
                        <span class="pillar earth">戊</span>
                        <span class="pillar water">壬</span>
                        <span class="pillar fire">丙</span>
                        <span class="pillar earth">戊</span>
                    </div>
                </div>

                <div class="case-item">
                    <div class="case-info">
                        <div class="case-header">
                            <span class="case-name">案例2</span>
                            <span class="case-gender male">男</span>
                        </div>
                        <div class="case-date">阳历：1985年03月15日</div>
                    </div>
                    <div class="case-pillars">
                        <span class="pillar wood">乙</span>
                        <span class="pillar earth">己</span>
                        <span class="pillar fire">丙</span>
                        <span class="pillar water">壬</span>
                    </div>
                </div>
            </div>

            <!-- 添加按钮 -->
            <button class="btn btn-add">
                <span class="icon">+</span> 新增案例
            </button>
        </aside>

        <!-- 中间栏 - 精确还原Figma设计稿 -->
        <section class="content-main figma-content">
            <!-- 顶部头部区域 -->
            <div class="figma-header">
                <!-- 生肖头像 -->
                <div class="figma-avatar-wrap">
                    <span class="figma-zodiac-icon">🐰</span>
                </div>
                <!-- 案例名称 -->
                <div class="figma-name">案例6</div>
                <!-- 日期信息 -->
                <div class="figma-dates">
                    <div class="figma-date-line">
                        <span class="figma-label">阴历:</span>
                        <span class="figma-value">1998年八月廿六 子时</span>
                        <span class="figma-tag kunzao">（坤造）</span>
                    </div>
                    <div class="figma-date-line">
                        <span class="figma-label">阳历:</span>
                        <span class="figma-value">1998年10月16日 00:08</span>
                    </div>
                </div>
                <!-- 编辑按钮 -->
                <button class="figma-edit-btn">编辑</button>
            </div>

            <!-- 主内容区 - 两栏布局 -->
            <div class="figma-content-grid">
                <!-- 左侧：排盘详情表格 -->
                <div class="figma-pan-table">
                    <!-- 表格 -->
                    <table class="pan-table">
                        <thead>
                            <tr>
                                <th class="pan-label-col"></th>
                                <th>流年</th>
                                <th>大运</th>
                                <th>年柱</th>
                                <th>月柱</th>
                                <th>日柱</th>
                                <th>时柱</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- 日期行 -->
                            <tr>
                                <td class="pan-label">日期</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                            <!-- 主星行 -->
                            <tr>
                                <td class="pan-label">主星</td>
                                <td></td>
                                <td>正印</td>
                                <td>伤官</td>
                                <td>食神</td>
                                <td>七杀</td>
                                <td>食神</td>
                            </tr>
                            <!-- 天干行 -->
                            <tr class="pan-row-tiangan">
                                <td class="pan-label">天干</td>
                                <td><span class="gan-box wood">乙</span></td>
                                <td><span class="gan-box earth">己</span></td>
                                <td><span class="gan-box earth">戊</span></td>
                                <td><span class="gan-box water">壬</span></td>
                                <td><span class="gan-box fire">丙</span></td>
                                <td><span class="gan-box earth">戊</span></td>
                            </tr>
                            <!-- 地支行 -->
                            <tr class="pan-row-dizhi">
                                <td class="pan-label">地支</td>
                                <td><span class="zhi-box fire">巳</span></td>
                                <td><span class="zhi-box fire">未</span></td>
                                <td><span class="zhi-box wood">寅</span></td>
                                <td><span class="zhi-box earth">辰</span></td>
                                <td><span class="zhi-box metal">申</span></td>
                                <td><span class="zhi-box water">子</span></td>
                            </tr>
                            <!-- 藏干行 -->
                            <tr class="pan-row-canggan">
                                <td class="pan-label">藏干</td>
                                <td>
                                    <span class="cg fire">丙</span><span class="ss">比肩</span><br>
                                    <span class="cg metal">庚</span><span class="ss">偏财</span><br>
                                    <span class="cg earth">戊</span><span class="ss">食神</span>
                                </td>
                                <td>
                                    <span class="cg fire">丁</span><span class="ss">劫财</span><br>
                                    <span class="cg wood">乙</span><span class="ss">正印</span>
                                </td>
                                <td>
                                    <span class="cg wood">甲</span><span class="ss">偏印</span><br>
                                    <span class="cg fire">丙</span><span class="ss">比肩</span><br>
                                    <span class="cg earth">戊</span><span class="ss">食神</span>
                                </td>
                                <td>
                                    <span class="cg earth">戊</span><span class="ss">食神</span><br>
                                    <span class="cg wood">乙</span><span class="ss">正印</span><br>
                                    <span class="cg water">癸</span><span class="ss">正官</span>
                                </td>
                                <td>
                                    <span class="cg metal">庚</span><span class="ss">偏财</span><br>
                                    <span class="cg water">壬</span><span class="ss">七杀</span><br>
                                    <span class="cg earth">戊</span><span class="ss">食神</span>
                                </td>
                                <td>
                                    <span class="cg water">癸</span><span class="ss">正官</span>
                                </td>
                            </tr>
                            <!-- 星运行 -->
                            <tr>
                                <td class="pan-label">星运</td>
                                <td>临官</td>
                                <td>衰</td>
                                <td>长生</td>
                                <td>墓</td>
                                <td>病</td>
                                <td>胎</td>
                            </tr>
                            <!-- 自坐行 -->
                            <tr>
                                <td class="pan-label">自坐</td>
                                <td>沐浴</td>
                                <td>冠带</td>
                                <td>长生</td>
                                <td>冠带</td>
                                <td>病</td>
                                <td>胎</td>
                            </tr>
                            <!-- 空亡行 -->
                            <tr>
                                <td class="pan-label">空亡</td>
                                <td>寅卯</td>
                                <td>子丑</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td>午未</td>
                            </tr>
                            <!-- 纳音行 -->
                            <tr>
                                <td class="pan-label">纳音</td>
                                <td>覆灯火</td>
                                <td>天上火</td>
                                <td>城头土</td>
                                <td>大海水</td>
                                <td>山下火</td>
                                <td>霹雳火</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- 神煞区域 - grid布局对齐表格列 -->
                    <div class="pan-shenshu">
                        <div class="shenshu-label">神煞</div>
                        <div class="shenshu-col">
                            <span>天厨贵人</span>
                            <span>勾绞煞</span>
                            <span>空亡</span>
                            <span>禄神</span>
                            <span>亡神</span>
                            <span>血刃</span>
                            <span>劫煞</span>
                        </div>
                        <div class="shenshu-col">
                            <span>天乙贵人</span>
                            <span>太极贵人</span>
                            <span>金舆</span>
                            <span>流霞</span>
                            <span>天喜</span>
                            <span>元辰</span>
                        </div>
                        <div class="shenshu-col">
                            <span>福星贵人</span>
                            <span>德秀贵人</span>
                            <span>红艳煞</span>
                            <span>驿马</span>
                        </div>
                        <div class="shenshu-col">
                            <span>太极贵人</span>
                            <span>华盖</span>
                            <span>福星贵人</span>
                            <span>天德贵人</span>
                            <span>月德贵人</span>
                            <span>空亡</span>
                        </div>
                        <div class="shenshu-col">
                            <span>十恶大败</span>
                            <span>文昌贵人</span>
                            <span>天厨贵人</span>
                            <span>吊客</span>
                            <span>驿马</span>
                            <span>学堂</span>
                        </div>
                        <div class="shenshu-col">
                            <span>福星贵人</span>
                            <span>德秀贵人</span>
                            <span>童子煞</span>
                            <span>飞刃</span>
                            <span>灾煞</span>
                            <span>将星</span>
                        </div>
                    </div>
                </div>

                <!-- 右侧：大运流年 -->
                <div class="figma-right-panel">
                    <!-- 起运信息 -->
                    <div class="dayun-info">
                        <span>起运: 出生后2年4月20天24时起运</span>
                        <span>交运: 逢辛、丙年 惊蛰后3天 交大运</span>
                        <span class="right">辰巳空亡（日）</span>
                    </div>

                    <!-- 大运表格 -->
                    <table class="dayun-table">
                        <thead>
                            <tr>
                                <th></th>
                                <th>1998</th>
                                <th>2001</th>
                                <th>2011</th>
                                <th class="active">2021</th>
                                <th>2031</th>
                                <th>2041</th>
                                <th>2051</th>
                                <th>2061</th>
                                <th>2071</th>
                                <th>2081</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="row-label">大运</td>
                                <td>小</td>
                                <td>1-3岁</td>
                                <td>14岁</td>
                                <td class="active">24岁</td>
                                <td>34岁</td>
                                <td>44岁</td>
                                <td>54岁</td>
                                <td>64岁</td>
                                <td>74岁</td>
                                <td>84岁</td>
                            </tr>
                            <tr class="tiangan-row">
                                <td></td>
                                <td><span class="gm fire">丙</span></td>
                                <td><span class="gm metal">辛</span></td>
                                <td><span class="gm metal">庚</span></td>
                                <td class="active"><span class="gm earth">己</span></td>
                                <td><span class="gm earth">戊</span></td>
                                <td><span class="gm fire">丁</span></td>
                                <td><span class="gm fire">丙</span></td>
                                <td><span class="gm wood">乙</span></td>
                                <td><span class="gm wood">甲</span></td>
                                <td><span class="gm water">癸</span></td>
                            </tr>
                            <tr class="dizhi-row">
                                <td></td>
                                <td><span class="zm fire">午</span></td>
                                <td><span class="zm metal">酉</span></td>
                                <td><span class="zm metal">申</span></td>
                                <td class="active"><span class="zm fire">未</span></td>
                                <td><span class="zm fire">午</span></td>
                                <td><span class="zm fire">巳</span></td>
                                <td><span class="zm earth">辰</span></td>
                                <td><span class="zm wood">卯</span></td>
                                <td><span class="zm wood">寅</span></td>
                                <td><span class="zm earth">丑</span></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- 流年表格 -->
                    <table class="liunian-table">
                        <thead>
                            <tr>
                                <th></th>
                                <th>2021</th>
                                <th>2022</th>
                                <th>2023</th>
                                <th class="active">2024</th>
                                <th>2025</th>
                                <th>2026</th>
                                <th>2027</th>
                                <th>2028</th>
                                <th>2029</th>
                                <th>2030</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="tiangan-row">
                                <td class="row-label">流年</td>
                                <td><span class="gm metal">辛</span></td>
                                <td><span class="gm water">壬</span></td>
                                <td><span class="gm water">癸</span></td>
                                <td class="active"><span class="gm wood">甲</span></td>
                                <td><span class="gm wood">乙</span></td>
                                <td><span class="gm fire">丙</span></td>
                                <td><span class="gm fire">丁</span></td>
                                <td><span class="gm earth">戊</span></td>
                                <td><span class="gm earth">己</span></td>
                                <td><span class="gm metal">庚</span></td>
                            </tr>
                            <tr class="dizhi-row">
                                <td></td>
                                <td><span class="zm earth">丑</span></td>
                                <td><span class="zm wood">寅</span></td>
                                <td><span class="zm wood">卯</span></td>
                                <td class="active"><span class="zm earth">辰</span></td>
                                <td><span class="zm fire">巳</span></td>
                                <td><span class="zm fire">午</span></td>
                                <td><span class="zm fire">未</span></td>
                                <td><span class="zm metal">申</span></td>
                                <td><span class="zm metal">酉</span></td>
                                <td><span class="zm earth">戌</span></td>
                            </tr>
                            <tr class="xiaoyun-row">
                                <td class="row-label">小运</td>
                                <td>甲子</td>
                                <td>癸亥</td>
                                <td>壬戌</td>
                                <td class="active">辛酉</td>
                                <td>庚申</td>
                                <td>己未</td>
                                <td>戊午</td>
                                <td>丁巳</td>
                                <td>丙辰</td>
                                <td>乙卯</td>
                            </tr>
                            <tr class="jieqi-row">
                                <td></td>
                                <td>立春<br>2/3</td>
                                <td>惊蛰<br>3/5</td>
                                <td>清明<br>4/4</td>
                                <td class="active">立夏<br>5/5</td>
                                <td>芒种<br>6/5</td>
                                <td>小暑<br>7/7</td>
                                <td>立秋<br>8/7</td>
                                <td>白露<br>9/7</td>
                                <td>寒露<br>10/8</td>
                                <td>立冬<br>11/7</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- 智能四柱图示 -->
                    <div class="sizhu-section">
                        <div class="sizhu-title">智能四柱图示</div>
                        <div class="sizhu-content">
                            <p class="sizhu-placeholder">四柱图示区域</p>
                        </div>
                        <div class="sizhu-footer">
                            <button class="sizhu-btn">⚙</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- 底部状态栏 -->
    <footer class="footer">
        <div class="footer-info">
            <span>© 2024 随心所欲 - 专业八字排盘系统</span>
        </div>
        <div class="footer-links">
            <a href="#">使用帮助</a>
            <a href="#">隐私政策</a>
            <a href="#">关于我们</a>
        </div>
    </footer>
</body>

</html>