{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Orbis",
  "version": "0.1.0",
  "identifier": "com.orbis.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:9898",
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Orbis",
        "width": 1800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
