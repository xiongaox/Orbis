{
    // 本分支（tauri 本地化线）不发布 Cloudflare，正式站只有 main 分支会部署（见 scripts/deploy.mjs）。
    // 这里保留 orbis-verify 作为兜底：即使有人绕过脚本裸敲 `npx wrangler deploy`，也打不到正式站 orbis。
    "name": "orbis-verify",
    "main": "workers/case-library/src/index.ts",
    "compatibility_date": "2026-08-27",
    "d1_databases": [
        {
            "binding": "CASE_LIBRARY_DB",
            "database_name": "orbis",
            "database_id": "1c95d7a4-af31-4bec-bcf0-4b71db262b9f",
            "migrations_dir": "workers/case-library/migrations"
        }
    ],
    "r2_buckets": [
        {
            "binding": "CASE_LIBRARY_BUCKET",
            "bucket_name": "orbis"
        }
    ],
    "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
    }
}
